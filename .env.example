# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- Public: compiled into assets/dist/bundle.js by webpack ---
# These are safe to expose; they are readable in page source by design.
TURNSTILE_SITEKEY=
EMAILJS_PUBLIC_KEY=
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=

# Leave blank to send through EmailJS from the browser.
# Set to the public URL of server/index.js to route through Elastic Email instead.
CONTACT_ENDPOINT=

# --- Server only: read at runtime by server/index.js, never bundled ---
# webpack.config.js will refuse to build if any of these is added to PUBLIC_KEYS.
PORT=3000
ELASTIC_EMAIL_API_KEY=
ELASTIC_FROM_EMAIL=
ELASTIC_TO_EMAIL=
ELASTIC_CONTACT_LIST=

# Turnstile secret key, from the same Cloudflare dashboard page as the sitekey.
# Required for the server to verify tokens.
TURNSTILE_SECRET_KEY=
